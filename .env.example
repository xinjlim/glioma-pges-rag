# Copy to .env and fill in. Variables already set in the shell take precedence.

# OpenRouter key for answer generation (chat, test --llm, evaluate) and the evaluation judge: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Answer generation: Gemini through OpenRouter by default
# GEN_BACKEND=openrouter            # or gemini: the same model through the Google API (needs GEMINI_API_KEY)
# GEMINI_API_KEY=                   # free key: https://aistudio.google.com/apikey
# GEMINI_MODELS=gemini-3.8-flash    # comma-separated list adds fallback models

# NCBI E-utilities (genes and pubmed steps): a contact email is required, the API key is optional
ENTREZ_EMAIL=
# NCBI_API_KEY=

# Evaluation judge: Qwen through OpenRouter by default
# JUDGE_BACKEND=openrouter          # or ollama: a local Qwen model (JUDGE_MODEL=qwen3:8b)
# JUDGE_MODEL=qwen/qwen3.8-27b
# OLLAMA_HOST=http://localhost:11434

# PORT=5000                         # web chat port
